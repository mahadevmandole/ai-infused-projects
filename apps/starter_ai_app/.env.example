APP_NAME=starter_ai_app
API_HOST=0.0.0.0
API_PORT=8000

# AI provider: mock, openai, groq, or gemini
AI_PROVIDER=mock
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=800

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
